# Server-only environment variables (configure these in Vercel Project Settings too).
# Use the project URL and anon/publishable key from Supabase Project Settings > API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# SECRET: server-side only. Never use a VITE_ prefix and never put this in public/supabase-config.js.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional: only needed if you separately run Prisma database commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
